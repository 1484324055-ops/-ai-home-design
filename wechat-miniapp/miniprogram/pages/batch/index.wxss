.batch-page {
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 12% 4%, rgba(14, 165, 233, 0.1), transparent 34%),
    linear-gradient(180deg, #f8fafc 0%, #f7f8fb 45%, #eef2f7 100%);
}

.hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0 18rpx;
}

.hero > view:first-child {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  color: #667085;
  font-size: 20rpx;
  font-weight: 850;
  letter-spacing: 5rpx;
}

.title {
  margin-top: 10rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.14;
}

.desc {
  margin-top: 14rpx;
  max-width: 500rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.58;
}

.count-card {
  display: flex;
  min-width: 132rpx;
  padding: 18rpx 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.06);
}

.count-number {
  color: #2563eb;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.count-label {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.notice {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 24rpx;
  line-height: 1.5;
}

.panel,
.result-panel {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.05);
}

.advanced-panel {
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(14, 165, 233, 0.08), transparent 38%),
    rgba(255, 255, 255, 0.97);
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.055);
}

.advanced-toggle {
  display: flex;
  width: 100%;
  min-height: 108rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: transparent;
  text-align: left;
}

.advanced-toggle-copy {
  min-width: 0;
  flex: 1;
}

.advanced-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 850;
}

.advanced-summary {
  margin-top: 4rpx;
  overflow: hidden;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advanced-default {
  margin-top: 4rpx;
  overflow: hidden;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advanced-state {
  display: flex;
  min-width: 88rpx;
  margin: 0;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 850;
}

.advanced-body {
  padding: 0 18rpx 18rpx;
}

.advanced-group {
  padding: 16rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 24rpx;
  background: rgba(248, 250, 252, 0.92);
}

.advanced-group + .advanced-group {
  margin-top: 14rpx;
}

.advanced-label {
  margin-bottom: 10rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 850;
}

.advanced-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.advanced-option {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 100%;
  margin: 0;
  min-width: 0;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  overflow: hidden;
  border: 2rpx solid #e4e7ec;
  border-radius: 20rpx;
  background: #ffffff;
  color: #344054;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.15;
  text-align: center;
}

.advanced-toggle::after,
.advanced-option::after {
  border: 0;
}

.advanced-option-name {
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advanced-option.selected {
  border-color: #2563eb;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.18), 0 10rpx 26rpx rgba(37, 99, 235, 0.12);
}

.advanced-residence-standard {
  background: linear-gradient(135deg, #eff6ff, #ffffff);
}

.advanced-residence-upscale {
  background: linear-gradient(135deg, #fef3c7, #ffffff);
}

.advanced-residence-luxury {
  background: linear-gradient(135deg, #f5f3ff, #ffffff);
}

.advanced-camera-wide-angle {
  background: linear-gradient(135deg, #ecfeff, #ffffff);
}

.advanced-camera-straight {
  background: linear-gradient(135deg, #f0fdf4, #ffffff);
}

.advanced-camera-45-degree {
  background: linear-gradient(135deg, #fff7ed, #ffffff);
}

.advanced-lighting-natural {
  background: linear-gradient(135deg, #fefce8, #ffffff);
}

.advanced-lighting-warm {
  background: linear-gradient(135deg, #fff1f2, #ffffff);
}

.advanced-lighting-cool {
  background: linear-gradient(135deg, #eef2ff, #ffffff);
}

.recommend-badge {
  display: inline-flex;
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: auto;
  height: 26rpx;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.12);
  color: #2563eb;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 26rpx;
}

.disabled-panel {
  opacity: 0.58;
}

.section-head,
.result-top,
.record-head,
.group-head {
  display: flex;
  align-items: center;
}

.section-head {
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.result-top,
.record-head,
.group-head {
  justify-content: space-between;
  gap: 18rpx;
}

.step {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 900;
}

.section-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 850;
}

.section-desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
}

.chip-grid,
.space-grid,
.cabinet-grid {
  display: grid;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
}

.chip-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.chip-card {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 118rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 16rpx 40rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  overflow: hidden;
  text-align: left;
}

.chip-card::after {
  position: absolute;
  top: -24rpx;
  right: -22rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.06);
  content: "";
}

.chip-copy {
  position: relative;
  z-index: 1;
  width: 100%;
  text-align: left;
}

.chip-name {
  width: 100%;
  overflow: hidden;
  color: #101828;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.style-chip .chip-name,
.material-chip .chip-name {
  display: -webkit-box;
  min-height: 60rpx;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.chip-sub {
  width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.palette-row,
.texture-strip {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  z-index: 1;
  display: flex;
  width: auto;
  height: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e7ec;
}

.palette-swatch {
  flex: 1;
}

.texture-strip {
  height: 22rpx;
}

.mini-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  margin: -4rpx 0 18rpx;
}

.mini-button,
.small-toggle {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475467;
  font-size: 22rpx;
  font-weight: 800;
}

.mini-button {
  width: 100%;
}

.space-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.space-matrix {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.space-row {
  display: grid;
  grid-template-columns: 184rpx minmax(0, 1fr);
  gap: 10rpx;
  box-sizing: border-box;
  min-height: 152rpx;
  padding: 10rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 40, 0.04);
}

.space-row.active {
  border-color: rgba(37, 99, 235, 0.36);
  background:
    radial-gradient(circle at 100% 0%, rgba(37, 99, 235, 0.12), transparent 34%),
    #f8fbff;
}

.space-row-head {
  display: flex;
  width: 100%;
  max-width: 100%;
  margin: 0;
  min-width: 0;
  min-height: 128rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 24rpx;
  background: #f8fafc;
  text-align: left;
}

.space-row-head::after,
.matrix-cabinet::after {
  border: 0;
}

.space-cabinet-area {
  display: grid;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  align-content: center;
}

.matrix-cabinet {
  width: 100%;
  max-width: 100%;
  margin: 0;
  min-width: 0;
  min-height: 58rpx;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
  line-height: 1.2;
}

.space-symbol {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eef2ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 900;
}

.space-meta {
  min-width: 0;
  flex: 1;
}

.space-name {
  display: block;
  overflow: hidden;
  color: #101828;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.2;
  white-space: normal;
}

.space-sub {
  display: inline-flex;
  margin-top: 6rpx;
  align-items: center;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(102, 112, 133, 0.08);
  color: #667085;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1;
}

.selected {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: 0 14rpx 32rpx rgba(37, 99, 235, 0.12);
}

.space-row-head.selected {
  border-color: rgba(37, 99, 235, 0.28);
  background: #eff6ff;
  box-shadow: none;
}

.space-horizontal-living .space-symbol,
.space-vertical-living .space-symbol,
.space-ldk .space-symbol,
.space-dining-room .space-symbol {
  background: #e0f2fe;
  color: #0284c7;
}

.space-kitchen .space-symbol,
.space-enclosed-kitchen .space-symbol,
.space-semi-enclosed-kitchen .space-symbol {
  background: #fff1e7;
  color: #ea580c;
}

.space-master-bedroom .space-symbol,
.space-secondary-bedroom .space-symbol,
.space-kids-room .space-symbol {
  background: #eef2ff;
  color: #4f46e5;
}

.space-study .space-symbol,
.space-balcony .space-symbol {
  background: #dcfce7;
  color: #16a34a;
}

.space-entrance .space-symbol,
.space-walk-in-closet .space-symbol,
.space-multi-functional .space-symbol {
  background: #f5f3ff;
  color: #7c3aed;
}

.selected .space-symbol {
  background: #2563eb;
  color: #ffffff;
}

.style-modern-minimalist { background: linear-gradient(135deg, #ffffff 0%, #eef2f7 100%); }
.style-modern-minimalist .one { background: #f7f8fa; }
.style-modern-minimalist .two { background: #cfd5dc; }
.style-modern-minimalist .three { background: #1f2937; }

.style-french-cream { background: linear-gradient(135deg, #fffaf0 0%, #f5dfc6 100%); }
.style-french-cream .one { background: #fff7ed; }
.style-french-cream .two { background: #f3d6b8; }
.style-french-cream .three { background: #b9895d; }

.style-italian-minimal { background: linear-gradient(135deg, #f4f0ea 0%, #18191f 110%); }
.style-italian-minimal .one { background: #111318; }
.style-italian-minimal .two { background: #6f6256; }
.style-italian-minimal .three { background: #d8d2c7; }

.style-japanese-wood { background: linear-gradient(135deg, #fbf6ee 0%, #d6b98d 100%); }
.style-japanese-wood .one { background: #f6efe4; }
.style-japanese-wood .two { background: #d6b98d; }
.style-japanese-wood .three { background: #7b6045; }

.style-modern-chinese { background: linear-gradient(135deg, #fbf7ef 0%, #7a1f1b 108%); }
.style-modern-chinese .one { background: #241915; }
.style-modern-chinese .two { background: #7a1f1b; }
.style-modern-chinese .three { background: #c6a16b; }

.style-wabi-sabi { background: linear-gradient(135deg, #f1eadf 0%, #9d9182 100%); }
.style-wabi-sabi .one { background: #e8dfd2; }
.style-wabi-sabi .two { background: #a79a89; }
.style-wabi-sabi .three { background: #6f675f; }

.style-american-vintage { background: linear-gradient(135deg, #f4eadc 0%, #2f4f3e 118%); }
.style-american-vintage .one { background: #f4eadc; }
.style-american-vintage .two { background: #8a5a36; }
.style-american-vintage .three { background: #2f4f3e; }

.material-a-oak-white .texture-strip { background: linear-gradient(90deg, #fff7ed 0 38%, #d7b98d 38% 72%, #f8fafc 72%); }
.material-b-gloss-white .texture-strip { background: linear-gradient(110deg, #ffffff 0 45%, #dbeafe 45% 52%, #111827 52%); }
.material-c-cream-brass .texture-strip { background: linear-gradient(90deg, #fff7ed 0 52%, #d4af37 52% 72%, #f2d6b3 72%); }
.material-d-dark-grey .texture-strip { background: linear-gradient(90deg, #111827 0 40%, #374151 40% 72%, #94a3b8 72%); }
.material-e-walnut-glass .texture-strip { background: linear-gradient(90deg, #3f2a1d 0 45%, #7c4a25 45% 72%, #d6b36a 72%); }
.material-f-cement-rattan .texture-strip { background: linear-gradient(90deg, #d8d1c7 0 42%, #b8976b 42% 70%, #756b5f 70%); }
.material-g-american-white .texture-strip { background: linear-gradient(90deg, #f8fafc 0 42%, #b08968 42% 66%, #6f4e37 66%); }
.material-h-matte-white .texture-strip { background: linear-gradient(90deg, #ffffff 0 48%, #e5e7eb 48% 74%, #cbd5e1 74%); }

.selected .space-symbol {
  background: #2563eb;
  color: #ffffff;
}

.inline-cabinet-box {
  margin: 4rpx 0 0;
  padding: 18rpx;
  border: 1rpx solid rgba(191, 219, 254, 0.82);
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.68)),
    #ffffff;
}

.inline-cabinet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.inline-cabinet-head > view:first-child {
  min-width: 0;
  flex: 1;
}

.inline-step-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #101828;
  font-size: 26rpx;
  font-weight: 900;
}

.small-toggle {
  min-width: 176rpx;
  flex-shrink: 0;
}

.inline-step {
  display: inline-flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.inline-cabinet-grid {
  gap: 12rpx;
  margin-top: 16rpx;
}

.empty-inline {
  padding: 28rpx 0;
  color: #667085;
  font-size: 24rpx;
  text-align: center;
}

.space-group {
  padding: 20rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 26rpx;
  background: #f8fafc;
}

.space-group + .space-group {
  margin-top: 16rpx;
}

.group-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 850;
}

.group-sub {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
}

.cabinet-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 18rpx;
}

.cabinet-card {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 20rpx;
  background: #ffffff;
  color: #344054;
  font-size: 24rpx;
  font-weight: 750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cabinet-card.matrix-cabinet {
  width: 100%;
  max-width: 100%;
  margin: 0;
  min-height: 58rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.cabinet-icon {
  flex-shrink: 0;
  font-size: 21rpx;
  line-height: 1;
}

.cabinet-name {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-cabinet-area .matrix-cabinet:nth-child(1) {
  border-color: #dbeafe;
  background: linear-gradient(135deg, #eff6ff, #ffffff);
}

.space-cabinet-area .matrix-cabinet:nth-child(2) {
  border-color: #dcfce7;
  background: linear-gradient(135deg, #f0fdf4, #ffffff);
}

.space-cabinet-area .matrix-cabinet:nth-child(3) {
  border-color: #fed7aa;
  background: linear-gradient(135deg, #fff7ed, #ffffff);
}

.space-cabinet-area .matrix-cabinet:nth-child(4) {
  border-color: #e9d5ff;
  background: linear-gradient(135deg, #faf5ff, #ffffff);
}

.space-cabinet-area .matrix-cabinet.selected-soft {
  border-color: #2563eb;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.2);
}

.selected-soft {
  border-color: #2563eb;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.2);
}

.action-bar {
  position: sticky;
  bottom: 0;
  z-index: 5;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 251, 0), #f7f8fb 28%);
}

.primary-button,
.secondary-button {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.primary-button {
  flex: 1;
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 20rpx 42rpx rgba(37, 99, 235, 0.24);
}

.secondary-button {
  width: 150rpx;
  border: 1rpx solid #e4e7ec;
  background: #ffffff;
  color: #475467;
}

.button-disabled {
  opacity: 0.45;
}

.result-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
}

.copy-all-button,
.copy-one-button {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #111827;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
}

.copy-all-button {
  min-width: 144rpx;
}

.copy-one-button {
  min-width: 96rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.result-card {
  padding: 20rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 26rpx;
  background: #ffffff;
}

.record-title {
  max-width: 430rpx;
  overflow: hidden;
  color: #101828;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-sub {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.prompt-preview {
  display: -webkit-box;
  margin-top: 16rpx;
  padding: 18rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.62;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  user-select: text;
}
