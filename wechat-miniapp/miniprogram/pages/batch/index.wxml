<view class="batch-page safe-bottom">
  <view class="hero">
    <view>
      <text class="eyebrow">BATCH STUDIO</text>
      <view class="title">批量生成</view>
      <view class="desc">以同一套风格和材质为中心，一次生成多个空间和柜体组合。</view>
    </view>
    <view class="count-card">
      <text class="count-number">{{comboCount}}</text>
      <text class="count-label">待生成</text>
    </view>
  </view>

  <view wx:if="{{assetMessage}}" class="notice">{{assetMessage}}</view>

  <view class="panel">
    <view class="section-head">
      <view class="step">1</view>
      <view>
        <view class="section-title">选择风格</view>
        <view class="section-desc">先统一整批方案的画面调性</view>
      </view>
    </view>
    <view class="chip-grid">
      <button
        wx:for="{{styles}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectStyle"
        class="chip-card style-chip style-{{item.id}} {{selectedStyleId === item.id ? 'selected' : ''}}"
      >
        <view class="chip-copy">
          <text class="chip-name">{{item.name}}</text>
        </view>
        <view class="palette-row">
          <view class="palette-swatch one"></view>
          <view class="palette-swatch two"></view>
          <view class="palette-swatch three"></view>
        </view>
      </button>
    </view>
  </view>

  <view class="panel {{selectedStyleId ? '' : 'disabled-panel'}}">
    <view class="section-head">
      <view class="step">2</view>
      <view>
        <view class="section-title">选择材质套餐</view>
        <view class="section-desc">{{selectedStyleId ? '只显示适配当前风格的材质' : '请先选择风格'}}</view>
      </view>
    </view>
    <view class="chip-grid">
      <button
        wx:for="{{materials}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectMaterial"
        class="chip-card material-chip material-{{item.id}} {{selectedMaterialId === item.id ? 'selected' : ''}}"
      >
        <view class="chip-copy">
          <text class="chip-name">{{item.name}}</text>
        </view>
        <view class="texture-strip"></view>
      </button>
    </view>
  </view>

  <view class="advanced-panel">
    <button class="advanced-toggle" bindtap="toggleAdvanced">
      <view class="advanced-toggle-copy">
        <view class="advanced-title-row">
          <view class="advanced-title">更多选项</view>
          <view class="advanced-tags">
            <text>住宅类型</text>
            <text>镜头</text>
            <text>光影</text>
          </view>
        </view>
        <view class="advanced-summary">默认：商品房 · 广角全景 · 明亮自然光</view>
      </view>
      <view class="advanced-state">{{isAdvancedOpen ? '收起' : '展开'}}</view>
    </button>

    <view wx:if="{{isAdvancedOpen}}" class="advanced-body">
      <view class="advanced-group">
        <view class="advanced-label">住宅类型</view>
        <view class="advanced-grid">
          <button
            wx:for="{{residenceTypes}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectResidenceType"
            class="advanced-option advanced-residence-{{item.id}} {{selectedResidenceTypeId === item.id ? 'selected' : ''}}"
          >
            <text class="advanced-option-name">{{item.name}}</text>
            <text wx:if="{{item.id === 'standard'}}" class="recommend-badge">默认</text>
          </button>
        </view>
      </view>

      <view class="advanced-group">
        <view class="advanced-label">镜头</view>
        <view class="advanced-grid">
          <button
            wx:for="{{cameraAngles}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectCameraAngle"
            class="advanced-option advanced-camera-{{item.id}} {{selectedCameraAngleId === item.id ? 'selected' : ''}}"
          >
            <text class="advanced-option-name">{{item.name}}</text>
            <text wx:if="{{item.id === 'wide-angle'}}" class="recommend-badge">推荐</text>
          </button>
        </view>
      </view>

      <view class="advanced-group">
        <view class="advanced-label">光影</view>
        <view class="advanced-grid">
          <button
            wx:for="{{lightings}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectLighting"
            class="advanced-option advanced-lighting-{{item.id}} {{selectedLightingId === item.id ? 'selected' : ''}}"
          >
            <text class="advanced-option-name">{{item.name}}</text>
            <text wx:if="{{item.id === 'natural'}}" class="recommend-badge">推荐</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="step">3</view>
      <view>
        <view class="section-title">选择空间</view>
        <view class="section-desc">可单选、多选，也可一键选择全部组合</view>
      </view>
    </view>
    <view class="mini-actions">
      <button class="mini-button" bindtap="selectAllSpaces">全选空间</button>
      <button class="mini-button" bindtap="clearSpaces">清空选择</button>
    </view>

    <view class="space-matrix">
      <view
        wx:for="{{spaceCards}}"
        wx:for-item="space"
        wx:key="id"
        class="space-row {{space.selectedCount > 0 ? 'active' : ''}}"
      >
        <button
          data-space-id="{{space.id}}"
          bindtap="toggleAllCabinetsForSpace"
          class="space-row-head space-{{space.id}} {{space.selectedCount > 0 ? 'selected' : ''}}"
        >
          <view class="space-symbol">{{space.icon}}</view>
          <view class="space-meta">
            <text class="space-name">{{space.name}}</text>
            <text class="space-sub">{{space.statusLabel}}</text>
          </view>
        </button>

        <view class="space-cabinet-area">
          <button
            wx:for="{{space.cabinets}}"
            wx:for-item="cabinet"
            wx:key="id"
            data-space-id="{{space.id}}"
            data-cabinet-id="{{cabinet.id}}"
            bindtap="toggleCabinet"
            class="cabinet-card matrix-cabinet {{cabinet.isSelected ? 'selected-soft' : ''}}"
          >
            <text class="cabinet-icon">{{cabinet.icon}}</text>
            <text class="cabinet-name">{{cabinet.name}}</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <button class="secondary-button" bindtap="resetBatch">重置</button>
    <button class="primary-button {{isReady ? '' : 'button-disabled'}}" bindtap="generateBatch">
      生成 {{comboCount}} 条
    </button>
  </view>

  <view wx:if="{{results.length}}" class="result-panel">
    <view class="result-top">
      <view>
        <text class="eyebrow">BATCH OUTPUT</text>
        <view class="result-title">已生成 {{results.length}} 条提示词</view>
      </view>
      <button class="copy-all-button" bindtap="copyAll">复制全部</button>
    </view>

    <view class="result-list">
      <view wx:for="{{results}}" wx:key="id" class="result-card">
        <view class="record-head">
          <view>
            <view class="record-title">{{index + 1}}. {{item.title}}</view>
            <view class="record-sub">{{item.spaceName}} · {{item.cabinetName}}</view>
          </view>
          <button class="copy-one-button" data-id="{{item.id}}" bindtap="copyOne">复制</button>
        </view>
        <view class="prompt-preview">{{item.chinese}}</view>
      </view>
    </view>
  </view>
</view>
