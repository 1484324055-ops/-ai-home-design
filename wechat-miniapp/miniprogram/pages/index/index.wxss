.page {
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 10% 0%, rgba(14, 165, 233, 0.12), transparent 34%),
    radial-gradient(circle at 88% 9%, rgba(245, 158, 11, 0.09), transparent 28%),
    linear-gradient(180deg, #f8fafc 0%, #f6f7fb 52%, #eef2f7 100%);
}

.hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0 18rpx;
}

.hero > view:first-child {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.title {
  margin-top: 10rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.14;
}

.subtitle {
  margin-top: 14rpx;
  max-width: 520rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-card {
  display: flex;
  min-width: 132rpx;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.06);
}

.hero-number {
  color: #2563eb;
  font-size: 40rpx;
  font-weight: 800;
}

.hero-label {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
}

.notice {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 24rpx;
  line-height: 1.5;
}

.quick-nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.quick-button {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e4e7ec;
  border-radius: 22rpx;
  background: #ffffff;
  color: #344054;
  font-size: 26rpx;
  font-weight: 700;
}

.planner-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(37, 99, 235, 0.12), transparent 32%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.06);
}

.planner-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.planner-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 31rpx;
  font-weight: 850;
  line-height: 1.3;
}

.planner-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.planner-percent {
  display: flex;
  min-width: 92rpx;
  height: 64rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #111827;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.progress-track {
  height: 14rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e7ec;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563eb, #0ea5e9);
}

.progress-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.progress-step {
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(248, 250, 252, 0.9);
  text-align: center;
}

.progress-step.done {
  background: #eff6ff;
}

.progress-step.active {
  background: #fff7ed;
}

.progress-dot {
  display: inline-flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #e4e7ec;
  color: #667085;
  font-size: 20rpx;
  font-weight: 900;
}

.progress-step.done .progress-dot {
  background: #2563eb;
  color: #ffffff;
}

.progress-step.active .progress-dot {
  background: #f97316;
  color: #ffffff;
}

.progress-label {
  margin-top: 8rpx;
  color: #344054;
  font-size: 21rpx;
  font-weight: 850;
}

.progress-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #667085;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-chips {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.summary-chip {
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 22rpx;
  background: #ffffff;
}

.summary-chip.ready {
  border-color: #bfdbfe;
  background: #eff6ff;
}

.chip-label {
  display: block;
  color: #667085;
  font-size: 20rpx;
  font-weight: 750;
}

.chip-value {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  color: #101828;
  font-size: 24rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel,
.result-panel {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.05);
}

.disabled-panel {
  opacity: 0.55;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.step {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 800;
}

.section-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 800;
}

.section-desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  min-width: 0;
}

.option-card {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 102rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 16rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  text-align: left;
}

.visual-card {
  position: relative;
  overflow: hidden;
}

.visual-card::after {
  position: absolute;
  top: 0;
  right: 0;
  width: 86rpx;
  height: 86rpx;
  border-bottom-left-radius: 999rpx;
  background: rgba(37, 99, 235, 0.06);
  content: "";
}

.option-mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff6ff;
}

.room-glyph {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #2563eb;
  border-radius: 8rpx 8rpx 12rpx 12rpx;
  border-top-width: 8rpx;
}

.cabinet-mark {
  flex-direction: column;
  gap: 7rpx;
  background: #f1f5f9;
}

.cabinet-line {
  width: 24rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #475467;
}

.cabinet-line.wide {
  width: 34rpx;
}

.option-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
  align-self: center;
}

.option-hint {
  display: block;
  width: 100%;
  margin-top: 5rpx;
  overflow: hidden;
  color: #667085;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.style-card,
.material-card {
  min-height: 126rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 18rpx 16rpx 40rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96)),
    #ffffff;
}

.palette-row,
.texture-strip {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  z-index: 1;
  display: flex;
  width: auto;
  height: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e7ec;
}

.palette-swatch {
  flex: 1;
}

.texture-strip {
  height: 22rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.38);
}

.selected {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: 0 14rpx 32rpx rgba(37, 99, 235, 0.12);
}

.selected .option-mark {
  background: #2563eb;
}

.selected .room-glyph {
  border-color: #ffffff;
}

.selected .cabinet-line {
  background: #ffffff;
}

.option-name {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #101828;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.style-card .option-copy,
.material-card .option-copy {
  width: 100%;
  flex: none;
  text-align: left;
}

.style-card .option-name,
.material-card .option-name,
.style-card .option-hint,
.material-card .option-hint {
  text-align: left;
}

.space-horizontal-living .option-mark,
.space-vertical-living .option-mark,
.space-ldk .option-mark,
.space-dining-room .option-mark {
  background: #e0f2fe;
}

.space-horizontal-living .room-glyph,
.space-vertical-living .room-glyph,
.space-ldk .room-glyph,
.space-dining-room .room-glyph {
  border-color: #0284c7;
}

.space-kitchen .option-mark,
.space-enclosed-kitchen .option-mark,
.space-semi-enclosed-kitchen .option-mark {
  background: #fff1e7;
}

.space-kitchen .room-glyph,
.space-enclosed-kitchen .room-glyph,
.space-semi-enclosed-kitchen .room-glyph {
  border-color: #ea580c;
}

.space-master-bedroom .option-mark,
.space-secondary-bedroom .option-mark,
.space-kids-room .option-mark {
  background: #eef2ff;
}

.space-master-bedroom .room-glyph,
.space-secondary-bedroom .room-glyph,
.space-kids-room .room-glyph {
  border-color: #4f46e5;
}

.space-study .option-mark,
.space-balcony .option-mark {
  background: #dcfce7;
}

.space-study .room-glyph,
.space-balcony .room-glyph {
  border-color: #16a34a;
}

.space-entrance .option-mark,
.space-walk-in-closet .option-mark,
.space-multi-functional .option-mark {
  background: #f5f3ff;
}

.space-entrance .room-glyph,
.space-walk-in-closet .room-glyph,
.space-multi-functional .room-glyph {
  border-color: #7c3aed;
}

.style-modern-minimalist .one { background: #f8fafc; }
.style-modern-minimalist .two { background: #cbd5e1; }
.style-modern-minimalist .three { background: #334155; }

.style-french-cream .one { background: #fff7ed; }
.style-french-cream .two { background: #f5d0a9; }
.style-french-cream .three { background: #c08457; }

.style-italian-minimal .one { background: #111827; }
.style-italian-minimal .two { background: #6b7280; }
.style-italian-minimal .three { background: #d1d5db; }

.style-japanese-wood .one { background: #f5efe4; }
.style-japanese-wood .two { background: #c8a77a; }
.style-japanese-wood .three { background: #7c5f43; }

.style-modern-chinese .one { background: #1f2937; }
.style-modern-chinese .two { background: #8b5a2b; }
.style-modern-chinese .three { background: #d8c3a5; }

.style-wabi-sabi .one { background: #e7dfd2; }
.style-wabi-sabi .two { background: #a89f91; }
.style-wabi-sabi .three { background: #6f675f; }

.style-american-vintage .one { background: #f7f1e8; }
.style-american-vintage .two { background: #8a6a45; }
.style-american-vintage .three { background: #b08968; }

.material-a-oak-white .texture-strip { background: linear-gradient(90deg, #fff7ed 0 38%, #d7b98d 38% 72%, #f8fafc 72%); }
.material-b-gloss-white .texture-strip { background: linear-gradient(110deg, #ffffff 0 45%, #dbeafe 45% 52%, #111827 52%); }
.material-c-cream-brass .texture-strip { background: linear-gradient(90deg, #fff7ed 0 52%, #d4af37 52% 72%, #f2d6b3 72%); }
.material-d-dark-grey .texture-strip { background: linear-gradient(90deg, #111827 0 40%, #374151 40% 72%, #94a3b8 72%); }
.material-e-walnut-glass .texture-strip { background: linear-gradient(90deg, #3f2a1d 0 45%, #7c4a25 45% 72%, #d6b36a 72%); }
.material-f-cement-rattan .texture-strip { background: linear-gradient(90deg, #d8d1c7 0 42%, #b8976b 42% 70%, #756b5f 70%); }
.material-g-american-white .texture-strip { background: linear-gradient(90deg, #f8fafc 0 42%, #b08968 42% 66%, #6f4e37 66%); }
.material-h-matte-white .texture-strip { background: linear-gradient(90deg, #ffffff 0 48%, #e5e7eb 48% 74%, #cbd5e1 74%); }

.action-bar {
  position: sticky;
  bottom: 0;
  z-index: 5;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 251, 0), #f7f8fb 28%);
}

.primary-button,
.secondary-button {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button {
  flex: 1;
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 20rpx 42rpx rgba(37, 99, 235, 0.24);
}

.secondary-button {
  width: 150rpx;
  border: 1rpx solid #e4e7ec;
  background: #ffffff;
  color: #475467;
}

.button-disabled {
  opacity: 0.45;
}

.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.result-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.copy-button {
  display: flex;
  min-width: 112rpx;
  min-height: 68rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #111827;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.tab-row {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.tab {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 24rpx;
  font-weight: 700;
}

.active-tab {
  background: #eff6ff;
  color: #2563eb;
}

.prompt-box {
  margin-top: 18rpx;
  max-height: 560rpx;
  min-height: 260rpx;
  padding: 22rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(248, 250, 252, 0.96)),
    #f8fafc;
  color: #182230;
  font-size: 26rpx;
  line-height: 1.75;
  user-select: text;
}

.result-footer {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.copy-tip {
  grid-column: 1 / -1;
  min-width: 0;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}

.favorite-button,
.copy-wide-button {
  display: flex;
  width: 100%;
  min-height: 74rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.favorite-button {
  border: 1rpx solid #fed7aa;
  background: #fff7ed;
  color: #c2410c;
}

.favorite-button.favorited {
  border-color: #bfdbfe;
  background: #eff6ff;
  color: #2563eb;
}

.copy-wide-button {
  background: #111827;
  color: #ffffff;
}

.platform-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: #ffffff;
}

.platform-title {
  color: #101828;
  font-size: 26rpx;
  font-weight: 850;
}

.platform-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.platform-card {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.platform-card.domestic {
  background: #f0fdf4;
}

.platform-card.global {
  background: #eff6ff;
}

.platform-logo {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #111827;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.platform-name {
  overflow: hidden;
  color: #101828;
  font-size: 23rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.platform-desc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #667085;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
