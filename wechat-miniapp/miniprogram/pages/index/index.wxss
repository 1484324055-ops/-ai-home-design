.page {
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 10% 0%, rgba(14, 165, 233, 0.12), transparent 34%),
    radial-gradient(circle at 88% 9%, rgba(245, 158, 11, 0.09), transparent 28%),
    linear-gradient(180deg, #f8fafc 0%, #f6f7fb 52%, #eef2f7 100%);
}

.hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0 18rpx;
}

.hero > view:first-child {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 10rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.14;
}

.subtitle {
  margin-top: 14rpx;
  max-width: 520rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-card {
  display: flex;
  min-width: 132rpx;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.06);
}

.hero-number {
  color: #2563eb;
  font-size: 40rpx;
  font-weight: 800;
}

.hero-label {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
}

.notice {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 24rpx;
  line-height: 1.5;
}

.quick-nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.quick-button {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e4e7ec;
  border-radius: 22rpx;
  background: #ffffff;
  color: #344054;
  font-size: 26rpx;
  font-weight: 700;
}

.planner-card {
  position: relative;
  z-index: 12;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(37, 99, 235, 0.12), transparent 32%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.06);
}

.planner-card.is-pinned {
  position: fixed;
  top: 0;
  right: 24rpx;
  left: 24rpx;
  z-index: 50;
  margin: 0;
  border-color: rgba(37, 99, 235, 0.26);
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.16);
}

.planner-placeholder {
  height: 222rpx;
}

.compact-planner {
  padding: 18rpx;
  border-color: rgba(37, 99, 235, 0.18);
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.96)),
    #ffffff;
  box-shadow: 0 20rpx 46rpx rgba(15, 23, 42, 0.1);
}

.advanced-panel {
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(14, 165, 233, 0.08), transparent 38%),
    rgba(255, 255, 255, 0.97);
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.055);
}

.advanced-toggle {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: transparent;
  text-align: left;
}

.advanced-toggle-copy {
  min-width: 0;
  flex: 1;
}

.advanced-title {
  color: #101828;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.35;
}

.advanced-summary {
  margin-top: 4rpx;
  overflow: hidden;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advanced-default {
  margin-top: 4rpx;
  overflow: hidden;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advanced-state {
  display: flex;
  min-width: 88rpx;
  margin: 0;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 850;
}

.advanced-body {
  padding: 0 18rpx 18rpx;
}

.advanced-group {
  padding: 16rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 24rpx;
  background: rgba(248, 250, 252, 0.92);
}

.advanced-group + .advanced-group {
  margin-top: 14rpx;
}

.advanced-label {
  margin-bottom: 10rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 850;
}

.advanced-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.advanced-option {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 100%;
  margin: 0;
  min-width: 0;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  overflow: hidden;
  border: 2rpx solid #e4e7ec;
  border-radius: 20rpx;
  background: #ffffff;
  color: #344054;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.15;
  text-align: center;
}

.advanced-toggle::after,
.advanced-option::after {
  border: 0;
}

.advanced-option-name {
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.advanced-option.selected {
  border-color: #2563eb;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  color: #1d4ed8;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.18), 0 10rpx 26rpx rgba(37, 99, 235, 0.12);
}

.advanced-residence-standard {
  background: linear-gradient(135deg, #eff6ff, #ffffff);
}

.advanced-residence-upscale {
  background: linear-gradient(135deg, #fef3c7, #ffffff);
}

.advanced-residence-luxury {
  background: linear-gradient(135deg, #f5f3ff, #ffffff);
}

.advanced-camera-wide-angle {
  background: linear-gradient(135deg, #ecfeff, #ffffff);
}

.advanced-camera-straight {
  background: linear-gradient(135deg, #f0fdf4, #ffffff);
}

.advanced-camera-45-degree {
  background: linear-gradient(135deg, #fff7ed, #ffffff);
}

.advanced-lighting-natural {
  background: linear-gradient(135deg, #fefce8, #ffffff);
}

.advanced-lighting-warm {
  background: linear-gradient(135deg, #fff1f2, #ffffff);
}

.advanced-lighting-cool {
  background: linear-gradient(135deg, #eef2ff, #ffffff);
}

.recommend-badge {
  display: inline-flex;
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: auto;
  height: 26rpx;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.12);
  color: #2563eb;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 26rpx;
}

.planner-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.planner-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 31rpx;
  font-weight: 850;
  line-height: 1.3;
}

.planner-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.compact-subtitle {
  margin-top: 6rpx;
  display: -webkit-box;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.planner-percent {
  display: flex;
  min-width: 92rpx;
  height: 64rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #111827;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.progress-track {
  height: 14rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e7ec;
}

.compact-planner .progress-track {
  height: 10rpx;
  margin-top: 14rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563eb, #0ea5e9);
}

.progress-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.compact-planner .progress-row {
  gap: 8rpx;
  margin-top: 12rpx;
}

.progress-step {
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(248, 250, 252, 0.9);
  text-align: center;
}

.compact-planner .progress-step {
  min-height: 80rpx;
  padding: 10rpx 6rpx;
  border-radius: 18rpx;
}

.progress-step.done {
  background: #eff6ff;
}

.progress-step.active {
  background: #fff7ed;
}

.progress-dot {
  display: inline-flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #e4e7ec;
  color: #667085;
  font-size: 20rpx;
  font-weight: 900;
}

.compact-planner .progress-dot {
  width: 34rpx;
  height: 34rpx;
  font-size: 18rpx;
}

.progress-step.done .progress-dot {
  background: #2563eb;
  color: #ffffff;
}

.progress-step.active .progress-dot {
  background: #f97316;
  color: #ffffff;
}

.progress-label {
  margin-top: 8rpx;
  color: #344054;
  font-size: 21rpx;
  font-weight: 850;
}

.compact-planner .progress-label {
  margin-top: 6rpx;
  font-size: 20rpx;
}

.progress-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #667085;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-planner .progress-value {
  margin-top: 2rpx;
  font-size: 18rpx;
}

.summary-chips {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.summary-chip {
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 22rpx;
  background: #ffffff;
}

.summary-chip.ready {
  border-color: #bfdbfe;
  background: #eff6ff;
}

.chip-label {
  display: block;
  color: #667085;
  font-size: 20rpx;
  font-weight: 750;
}

.chip-value {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  color: #101828;
  font-size: 24rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel,
.result-panel {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(16, 24, 40, 0.05);
}

.disabled-panel {
  opacity: 0.55;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.step {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 800;
}

.section-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 800;
}

.section-desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  min-width: 0;
}

.option-card {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 102rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 16rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  text-align: left;
}

.visual-card {
  position: relative;
  overflow: hidden;
}

.visual-card::after {
  position: absolute;
  top: 0;
  right: 0;
  width: 86rpx;
  height: 86rpx;
  border-bottom-left-radius: 999rpx;
  background: rgba(37, 99, 235, 0.06);
  content: "";
}

.option-mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff6ff;
}

.option-emoji {
  font-size: 30rpx;
  line-height: 1;
}

.cabinet-emoji {
  background: #f1f5f9;
}

.room-glyph {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #2563eb;
  border-radius: 8rpx 8rpx 12rpx 12rpx;
  border-top-width: 8rpx;
}

.cabinet-mark {
  flex-direction: column;
  gap: 7rpx;
  background: #f1f5f9;
}

.cabinet-line {
  width: 24rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #475467;
}

.cabinet-line.wide {
  width: 34rpx;
}

.option-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
  align-self: center;
}

.option-hint {
  display: block;
  width: 100%;
  margin-top: 5rpx;
  overflow: hidden;
  color: #667085;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.style-card,
.material-card {
  min-height: 118rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 18rpx 16rpx 40rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96)),
    #ffffff;
}

.palette-row,
.texture-strip {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  z-index: 1;
  display: flex;
  width: auto;
  height: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e7ec;
}

.palette-swatch {
  flex: 1;
}

.texture-strip {
  height: 22rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.38);
}

.selected {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: 0 14rpx 32rpx rgba(37, 99, 235, 0.12);
}

.selected .option-mark {
  background: #2563eb;
}

.selected .room-glyph {
  border-color: #ffffff;
}

.selected .cabinet-line {
  background: #ffffff;
}

.option-name {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #101828;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.style-card .option-name,
.material-card .option-name {
  display: -webkit-box;
  min-height: 62rpx;
  font-size: 26rpx;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.style-card .option-copy,
.material-card .option-copy {
  width: 100%;
  flex: none;
  text-align: left;
}

.style-card .option-name,
.material-card .option-name,
.style-card .option-hint,
.material-card .option-hint {
  text-align: left;
}

.space-horizontal-living .option-mark,
.space-vertical-living .option-mark,
.space-ldk .option-mark,
.space-dining-room .option-mark {
  background: #e0f2fe;
}

.space-horizontal-living .room-glyph,
.space-vertical-living .room-glyph,
.space-ldk .room-glyph,
.space-dining-room .room-glyph {
  border-color: #0284c7;
}

.space-kitchen .option-mark,
.space-enclosed-kitchen .option-mark,
.space-semi-enclosed-kitchen .option-mark {
  background: #fff1e7;
}

.space-kitchen .room-glyph,
.space-enclosed-kitchen .room-glyph,
.space-semi-enclosed-kitchen .room-glyph {
  border-color: #ea580c;
}

.space-master-bedroom .option-mark,
.space-secondary-bedroom .option-mark,
.space-kids-room .option-mark {
  background: #eef2ff;
}

.space-master-bedroom .room-glyph,
.space-secondary-bedroom .room-glyph,
.space-kids-room .room-glyph {
  border-color: #4f46e5;
}

.space-study .option-mark,
.space-balcony .option-mark {
  background: #dcfce7;
}

.space-study .room-glyph,
.space-balcony .room-glyph {
  border-color: #16a34a;
}

.space-entrance .option-mark,
.space-walk-in-closet .option-mark,
.space-multi-functional .option-mark {
  background: #f5f3ff;
}

.space-entrance .room-glyph,
.space-walk-in-closet .room-glyph,
.space-multi-functional .room-glyph {
  border-color: #7c3aed;
}

.style-modern-minimalist { background: linear-gradient(135deg, #ffffff 0%, #eef2f7 100%); }
.style-modern-minimalist .one { background: #f7f8fa; }
.style-modern-minimalist .two { background: #cfd5dc; }
.style-modern-minimalist .three { background: #1f2937; }

.style-french-cream { background: linear-gradient(135deg, #fffaf0 0%, #f5dfc6 100%); }
.style-french-cream .one { background: #fff7ed; }
.style-french-cream .two { background: #f3d6b8; }
.style-french-cream .three { background: #b9895d; }

.style-italian-minimal { background: linear-gradient(135deg, #f4f0ea 0%, #18191f 110%); }
.style-italian-minimal .one { background: #111318; }
.style-italian-minimal .two { background: #6f6256; }
.style-italian-minimal .three { background: #d8d2c7; }

.style-japanese-wood { background: linear-gradient(135deg, #fbf6ee 0%, #d6b98d 100%); }
.style-japanese-wood .one { background: #f6efe4; }
.style-japanese-wood .two { background: #d6b98d; }
.style-japanese-wood .three { background: #7b6045; }

.style-modern-chinese { background: linear-gradient(135deg, #fbf7ef 0%, #7a1f1b 108%); }
.style-modern-chinese .one { background: #241915; }
.style-modern-chinese .two { background: #7a1f1b; }
.style-modern-chinese .three { background: #c6a16b; }

.style-wabi-sabi { background: linear-gradient(135deg, #f1eadf 0%, #9d9182 100%); }
.style-wabi-sabi .one { background: #e8dfd2; }
.style-wabi-sabi .two { background: #a79a89; }
.style-wabi-sabi .three { background: #6f675f; }

.style-american-vintage { background: linear-gradient(135deg, #f4eadc 0%, #2f4f3e 118%); }
.style-american-vintage .one { background: #f4eadc; }
.style-american-vintage .two { background: #8a5a36; }
.style-american-vintage .three { background: #2f4f3e; }

.material-a-oak-white .texture-strip { background: linear-gradient(90deg, #fff7ed 0 38%, #d7b98d 38% 72%, #f8fafc 72%); }
.material-b-gloss-white .texture-strip { background: linear-gradient(110deg, #ffffff 0 45%, #dbeafe 45% 52%, #111827 52%); }
.material-c-cream-brass .texture-strip { background: linear-gradient(90deg, #fff7ed 0 52%, #d4af37 52% 72%, #f2d6b3 72%); }
.material-d-dark-grey .texture-strip { background: linear-gradient(90deg, #111827 0 40%, #374151 40% 72%, #94a3b8 72%); }
.material-e-walnut-glass .texture-strip { background: linear-gradient(90deg, #3f2a1d 0 45%, #7c4a25 45% 72%, #d6b36a 72%); }
.material-f-cement-rattan .texture-strip { background: linear-gradient(90deg, #d8d1c7 0 42%, #b8976b 42% 70%, #756b5f 70%); }
.material-g-american-white .texture-strip { background: linear-gradient(90deg, #f8fafc 0 42%, #b08968 42% 66%, #6f4e37 66%); }
.material-h-matte-white .texture-strip { background: linear-gradient(90deg, #ffffff 0 48%, #e5e7eb 48% 74%, #cbd5e1 74%); }

.action-bar {
  position: sticky;
  bottom: 0;
  z-index: 5;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 251, 0), #f7f8fb 28%);
}

.primary-button,
.secondary-button {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button {
  flex: 1;
  background: #2563eb;
  color: #ffffff;
