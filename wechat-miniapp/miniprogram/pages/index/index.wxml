<view class="page safe-bottom">
  <view class="hero">
    <view>
      <text class="eyebrow">PROMPT STUDIO</text>
      <view class="title">AI 全屋定制效果图生成器</view>
      <view class="subtitle">选择空间、柜体、风格和材质，快速生成可复制的生图提示词。</view>
    </view>
    <view class="hero-card">
      <text class="hero-number">{{isLoadingAssets ? "..." : spaces.length}}</text>
      <text class="hero-label">空间资产</text>
    </view>
  </view>

  <view wx:if="{{assetMessage}}" class="notice">{{assetMessage}}</view>

  <view class="quick-nav">
    <button class="quick-button" bindtap="goBatch">批量生成</button>
    <button class="quick-button" bindtap="goHistory">历史方案</button>
    <button class="quick-button" bindtap="goProfile">我的</button>
  </view>

  <view class="planner-card compact-planner {{isPlannerPinned ? 'is-pinned' : ''}}">
    <view class="planner-head">
      <view>
        <text class="eyebrow">CURRENT PLAN</text>
        <view class="planner-subtitle compact-subtitle">{{nextStepText}}</view>
      </view>
      <view class="planner-percent">{{progressPercent}}%</view>
    </view>

    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
    </view>

    <view class="progress-row">
      <view wx:for="{{progressSteps}}" wx:key="label" class="progress-step {{item.state}}">
        <view class="progress-dot">{{item.index}}</view>
        <view class="progress-label">{{item.label}}</view>
        <view class="progress-value">{{item.value}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{isPlannerPinned}}" class="planner-placeholder"></view>

  <view class="panel">
    <view class="section-head">
      <view class="step">1</view>
      <view>
        <view class="section-title">选择空间</view>
        <view class="section-desc">先确定场景，系统会筛选对应柜体</view>
      </view>
    </view>
    <view class="option-grid">
      <button
        wx:for="{{spaces}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectSpace"
        class="option-card visual-card space-option space-{{item.id}} {{selectedSpaceId === item.id ? 'selected' : ''}}"
      >
        <view class="option-mark option-emoji">{{item.icon}}</view>
        <view class="option-copy">
          <text class="option-name">{{item.name}}</text>
        </view>
      </button>
    </view>
  </view>

  <view class="panel {{selectedSpaceId ? '' : 'disabled-panel'}}">
    <view class="section-head">
      <view class="step">2</view>
      <view>
        <view class="section-title">选择柜体</view>
        <view class="section-desc">{{selectedSpaceId ? '选择当前空间要呈现的柜体' : '请先选择空间'}}</view>
      </view>
    </view>
    <view class="option-grid">
      <button
        wx:for="{{availableCabinets}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectCabinet"
        class="option-card visual-card cabinet-option cabinet-{{item.id}} {{selectedCabinetId === item.id ? 'selected' : ''}}"
      >
        <view class="option-mark option-emoji cabinet-emoji">{{item.icon}}</view>
        <view class="option-copy">
          <text class="option-name">{{item.name}}</text>
        </view>
      </button>
    </view>
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="step">3</view>
      <view>
        <view class="section-title">选择风格</view>
        <view class="section-desc">决定整体画面调性</view>
      </view>
    </view>
    <view class="option-grid">
      <button
        wx:for="{{styles}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectStyle"
        class="option-card visual-card style-card style-{{item.id}} {{selectedStyleId === item.id ? 'selected' : ''}}"
      >
        <view class="option-copy">
          <text class="option-name">{{item.name}}</text>
        </view>
        <view class="palette-row">
          <view class="palette-swatch one"></view>
          <view class="palette-swatch two"></view>
          <view class="palette-swatch three"></view>
        </view>
      </button>
    </view>
  </view>

  <view class="panel {{selectedStyleId ? '' : 'disabled-panel'}}">
    <view class="section-head">
      <view class="step">4</view>
      <view>
        <view class="section-title">选择材质</view>
        <view class="section-desc">{{selectedStyleId ? '选择适配当前风格的材质套餐' : '请先选择风格'}}</view>
      </view>
    </view>
    <view class="option-grid">
      <button
        wx:for="{{availableMaterials}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectMaterial"
        class="option-card visual-card material-card material-{{item.id}} {{selectedMaterialId === item.id ? 'selected' : ''}}"
      >
        <view class="option-copy">
          <text class="option-name">{{item.name}}</text>
        </view>
        <view class="texture-strip"></view>
      </button>
    </view>
  </view>

  <view class="advanced-panel">
    <button class="advanced-toggle" bindtap="toggleAdvanced">
      <view class="advanced-toggle-copy">
        <view class="advanced-title">更多选项</view>
        <view class="advanced-summary">住宅类型 · 镜头 · 光影</view>
        <view class="advanced-default">默认：商品房 · 广角全景 · 明亮自然光</view>
      </view>
      <view class="advanced-state">{{isAdvancedOpen ? '收起' : '展开'}}</view>
    </button>

    <view wx:if="{{isAdvancedOpen}}" class="advanced-body">
      <view class="advanced-group">
        <view class="advanced-label">住宅类型</view>
        <view class="advanced-grid">
          <button
            wx:for="{{residenceTypes}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectResidenceType"
            class="advanced-option advanced-residence-{{item.id}} {{selectedResidenceTypeId === item.id ? 'selected' : ''}}"
          >
            <text class="advanced-option-name">{{item.name}}</text>
            <text wx:if="{{item.id === 'standard'}}" class="recommend-badge">默认</text>
          </button>
        </view>
      </view>

      <view class="advanced-group">
        <view class="advanced-label">镜头</view>
        <view class="advanced-grid">
          <button
            wx:for="{{cameraAngles}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectCameraAngle"
            class="advanced-option advanced-camera-{{item.id}} {{selectedCameraAngleId === item.id ? 'selected' : ''}}"
          >
            <text class="advanced-option-name">{{item.name}}</text>
            <text wx:if="{{item.id === 'wide-angle'}}" class="recommend-badge">推荐</text>
          </button>
        </view>
      </view>

      <view class="advanced-group">
        <view class="advanced-label">光影</view>
        <view class="advanced-grid">
          <button
            wx:for="{{lightings}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectLighting"
            class="advanced-option advanced-lighting-{{item.id}} {{selectedLightingId === item.id ? 'selected' : ''}}"
          >
            <text class="advanced-option-name">{{item.name}}</text>
            <text wx:if="{{item.id === 'natural'}}" class="recommend-badge">推荐</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <button class="secondary-button" bindtap="resetAll">重置</button>
    <button class="primary-button {{isReady ? '' : 'button-disabled'}}" bindtap="generatePrompt">
      生成提示词
    </button>
  </view>

  <view id="result" wx:if="{{promptResult}}" class="result-panel">
    <view class="result-header">
      <view>
        <text class="eyebrow">GENERATED</text>
        <view class="result-title">{{promptResult.title}}</view>
        <view class="result-subtitle">优先复制中文版本，可直接粘贴到生图平台继续出图。</view>
      </view>
      <button class="copy-button" bindtap="copyPrompt">复制</button>
    </view>

    <view class="tab-row">
      <button
        data-tab="chinese"
        bindtap="setPromptTab"
        class="tab {{activePromptTab === 'chinese' ? 'active-tab' : ''}}"
      >
        中文
      </button>
      <button
        data-tab="english"
        bindtap="setPromptTab"
        class="tab {{activePromptTab === 'english' ? 'active-tab' : ''}}"
      >
        English
      </button>
    </view>

    <scroll-view class="prompt-box" scroll-y="true">
      <text user-select="true" wx:if="{{activePromptTab === 'chinese'}}">{{promptResult.chinese}}</text>
      <text user-select="true" wx:else>{{promptResult.english}}</text>
    </scroll-view>

    <view class="result-footer">
      <view class="copy-tip">长按文本也可以选择复制</view>
      <button class="favorite-button {{isFavoriteCurrent ? 'favorited' : ''}}" bindtap="favoriteCurrent">
        {{isFavoriteCurrent ? '已收藏' : '收藏常用'}}
      </button>
      <button class="edit-prompt-button" bindtap="openPromptEditor">编辑提示词</button>
      <button class="copy-wide-button" bindtap="copyPrompt">复制当前提示词</button>
    </view>

    <view class="platform-panel">
      <view class="platform-title">复制后可以粘贴到这些平台</view>
      <view class="platform-grid">
        <view class="platform-card domestic">
          <view class="platform-logo">豆</view>
          <view>
            <view class="platform-name">豆包</view>
            <view class="platform-desc">中文理解顺手</view>
          </view>
        </view>
        <view class="platform-card domestic">
          <view class="platform-logo">即</view>
          <view>
            <view class="platform-name">即梦</view>
            <view class="platform-desc">适合快速试图</view>
          </view>
        </view>
        <view class="platform-card global">
          <view class="platform-logo">C</view>
          <view>
            <view class="platform-name">ChatGPT</view>
            <view class="platform-desc">适合英文版本</view>
          </view>
        </view>
        <view class="platform-card global">
          <view class="platform-logo">MJ</view>
          <view>
            <view class="platform-name">Midjourney</view>
            <view class="platform-desc">建议用英文版</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isPromptEditorOpen}}" class="editor-mask">
    <view class="editor-sheet">
      <view class="editor-head">
        <view>
          <text class="eyebrow">PROMPT EDITOR</text>
          <view class="editor-title">编辑提示词</view>
          <view class="editor-desc">可以按实际画面需求微调，保存后会同步用于复制和历史记录。</view>
        </view>
        <button class="editor-close" bindtap="closePromptEditor">×</button>
      </view>

      <scroll-view class="editor-body" scroll-y="true">
        <view class="editor-field">
          <view class="editor-label">中文提示词</view>
          <textarea
            class="prompt-editor-textarea"
            value="{{editChinese}}"
            maxlength="-1"
            bindinput="onEditChineseInput"
          />
        </view>
        <view class="editor-field">
          <view class="editor-label">English Prompt</view>
          <textarea
            class="prompt-editor-textarea english"
            value="{{editEnglish}}"
            maxlength="-1"
            bindinput="onEditEnglishInput"
          />
        </view>
      </scroll-view>

      <view class="editor-actions">
        <button class="editor-secondary" bindtap="closePromptEditor">取消</button>
        <button class="editor-primary" bindtap="savePromptEdits">保存修改</button>
      </view>
    </view>
  </view>
</view>
