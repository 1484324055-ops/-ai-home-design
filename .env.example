# PostgreSQL connection string
# Local example:
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"

# JWT secret used to sign login tokens
# Please replace this with a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# The username that is allowed to view the admin data panel
ADMIN_USERNAME="your-admin-username"

# Optional feedback email notification settings
# If all fields below are configured, each new feedback can also be emailed to you
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="AI Home Design <noreply@example.com>"
FEEDBACK_NOTIFY_EMAIL="your@email.com"
